<Project>
  <!-- Shared build steps for HS mods. Per-mod settings live in the .csproj. -->

  <!-- Stop early with a clear message when the game folder is wrong. -->
  <Target Name="HsCheckPaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ValheimManagedDir)\assembly_valheim.dll')"
           Text="assembly_valheim.dll not found in '$(ValheimManagedDir)'. Set ValheimDir (game folder) or ValheimManagedDir in Local.props, with -p:ValheimDir=..., or with the VALHEIM_DIR environment variable." />
  </Target>

  <!-- Download the pinned libraries into lib/ once, and check each file's SHA-256. -->
  <Target Name="HsFetchLibs" BeforeTargets="ResolveAssemblyReferences" Condition="'@(HsLib)' != ''">
    <MakeDir Directories="$(LibDir)" />
    <DownloadFile SourceUrl="%(HsLib.Url)" DestinationFolder="$(LibDir)" DestinationFileName="%(HsLib.Identity).dll"
                  Condition="!Exists('$(LibDir)\%(HsLib.Identity).dll')" />
    <GetFileHash Files="@(HsLib->'$(LibDir)\%(Identity).dll')" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HsLibHash" />
    </GetFileHash>
    <!-- GetFileHash keeps the Sha256 metadata of each item; MSBuild compares strings without case. -->
    <Error Condition="'%(_HsLibHash.Sha256)' != '%(_HsLibHash.FileHash)'"
           Text="%(_HsLibHash.Identity) has SHA-256 %(_HsLibHash.FileHash), expected %(_HsLibHash.Sha256) (pinned in the .csproj). Delete the file to download it again, or change the pin on purpose." />
  </Target>

  <!-- Generate BuildInfo (GUID, name, version, Valheim version) from the .csproj properties. -->
  <Target Name="HsBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_HsBuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_HsBuildInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_HsBuildInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by build/HS.targets from the .csproj. Do not edit.;namespace $(RootNamespace)%3B;internal static class BuildInfo;{;    public const string Guid = &quot;$(PluginGuid)&quot;%3B;    public const string Name = &quot;$(PluginName)&quot;%3B;    public const string Version = &quot;$(Version)&quot;%3B;    public const string ValheimVersion = &quot;$(ValheimVersion)&quot;%3B;}" />
    <ItemGroup>
      <Compile Include="$(_HsBuildInfoFile)" />
      <FileWrites Include="$(_HsBuildInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Copy the merged DLL into DeployDir when one is set. -->
  <Target Name="HsDeploy" AfterTargets="ILRepacker" Condition="'$(DeployDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DeployDir)" Condition="'$(Configuration)' != 'Release' and Exists('$(TargetDir)$(TargetName).pdb')" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(DeployDir)" />
  </Target>

  <!-- Release builds: dist/<Name>-<Version>.zip in Thunderstore layout. -->
  <Target Name="HsPackage" AfterTargets="ILRepacker" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_HsStage>$(IntermediateOutputPath)thunderstore\</_HsStage>
      <_HsZip>$(DistDir)\$(PluginName)-$(Version).zip</_HsZip>
      <_HsManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\ThunderStore\manifest.json'))</_HsManifest>
      <_HsManifest>$([System.Text.RegularExpressions.Regex]::Replace($(_HsManifest), '"version_number"\s*:\s*"[^"]*"', '"version_number": "$(Version)"'))</_HsManifest>
      <_HsReadme>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\ThunderStore\README.md'))</_HsReadme>
    </PropertyGroup>
    <Error Condition="$(_HsManifest.Contains('TODO'))" Text="ThunderStore/manifest.json still contains TODO. Fill in description and website_url before packaging." />
    <Error Condition="$(_HsReadme.Contains('TODO'))" Text="ThunderStore/README.md still contains TODO. Write the mod's Thunderstore page before packaging." />
    <RemoveDir Directories="$(_HsStage)" />
    <MakeDir Directories="$(_HsStage)plugins;$(DistDir)" />
    <WriteLinesToFile File="$(_HsStage)manifest.json" Lines="$(_HsManifest)" Overwrite="true" />
    <Copy SourceFiles="ThunderStore\icon.png;ThunderStore\README.md;ThunderStore\CHANGELOG.md" DestinationFolder="$(_HsStage)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_HsStage)plugins" />
    <Delete Files="$(_HsZip)" />
    <ZipDirectory SourceDirectory="$(_HsStage)" DestinationFile="$(_HsZip)" />
    <Message Importance="high" Text="Packaged $(_HsZip)" />
  </Target>
</Project>
